{
  "name": "openclaw-tamagiclaw",
  "version": "0.1.3",
  "type": "module",
  "description": "Tamagiclaw core plugin (lazy tick, no dashboard)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "plugin:build": "npm run build",
    "plugin:validate": "openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.37"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.10.7",
      "pluginSdkVersion": "2026.10.7"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
