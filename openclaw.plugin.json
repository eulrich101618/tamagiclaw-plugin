{
  "id": "tamagiclaw",
  "name": "Tamagiclaw",
  "description": "Tamagiclaw core + tasks (lazy tick, no dashboard)",
  "version": "0.1.0",
  "categories": [
    "other"
  ],
  "contracts": {
    "tools": [
      "tamagi_status",
      "tamagi_did",
      "tamagi_played",
      "tamagi_cleaned",
      "tamagi_socialized",
      "tamagi_amused",
      "tamagi_log",
      "tamagi_task_list",
      "tamagi_task_show",
      "tamagi_task_run",
      "tamagi_task_done",
      "tamagi_task_add",
      "tamagi_task_edit"
    ]
  },
  "commandAliases": [
    {
      "name": "tamagi",
      "kind": "runtime-slash"
    }
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stateFile": {
        "type": "string",
        "description": "Absolute path to tamagiclaw state.json (default: ~/workspace/github/tamagiclaw/state.json)"
      },
      "agentFile": {
        "type": "string",
        "description": "Absolute path to tamagiclaw agent.json"
      }
    }
  }
}